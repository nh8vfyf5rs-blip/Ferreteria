@using Ferreteria.Extensions
@{
    ViewData["Title"] = "Proveedores";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Proveedores</h1>
        <p class="text-muted mb-0">Gestiona los proveedores de Fierro Nic.</p>
    </div>
    @if (User.HasPermission("proveedor.crear"))
    {
        <button type="button" id="btnNuevoProveedor" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#proveedorModal">
            <i class="fa-solid fa-plus me-1"></i> Nuevo Proveedor
        </button>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card admin-card">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <span class="fw-semibold">Proveedores registrados</span>
    </div>
    <div class="card-body table-responsive">
        <table id="tablaProveedores" class="table table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Empresa</th>
                    <th>Contacto</th>
                    <th>Correo</th>
                    <th>Dirección</th>
                    <th>Fecha Registro</th>
                    <th>Total Compras</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody id="tbodyProveedores"></tbody>
        </table>
    </div>
</div>

@if (User.HasPermission("proveedor.crear") || User.HasPermission("proveedor.actualizar"))
{
    <div class="modal fade" id="proveedorModal" tabindex="-1" aria-labelledby="proveedorModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <form id="proveedorForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="Id" name="Id" />

                    <div class="modal-header">
                        <h2 class="modal-title h5" id="proveedorModalLabel">Registrar / Editar Proveedor</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>

                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label for="NombreEmpresa" class="form-label">Nombre de la Empresa</label>
                                <input type="text" id="NombreEmpresa" name="NombreEmpresa" class="form-control" required />
                            </div>

                            <div class="col-md-6">
                                <label for="Contacto" class="form-label">Contacto</label>
                                <input type="text" id="Contacto" name="Contacto" class="form-control" required />
                            </div>

                            <div class="col-md-6">
                                <label for="Correo" class="form-label">Correo</label>
                                <input type="email" id="Correo" name="Correo" class="form-control" required />
                            </div>

                            <div class="col-md-6">
                                <label for="Direccion" class="form-label">Dirección</label>
                                <input type="text" id="Direccion" name="Direccion" class="form-control" required />
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" id="btnGuardarProveedor" class="btn btn-primary">Guardar Proveedor</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/proveedor.js" asp-append-version="true"></script>
}
