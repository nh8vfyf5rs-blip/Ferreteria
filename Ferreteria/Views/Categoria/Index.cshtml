@using Ferreteria.Extensions
@{
    ViewData["Title"] = "Categorías";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Categorías</h1>
        <p class="text-muted mb-0">Gestiona las categorías de productos de Fierro Nic.</p>
    </div>
    @if (User.HasPermission("categoria.crear"))
    {
        <button type="button" id="btnNuevaCategoria" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#categoriaModal">
            <i class="fa-solid fa-plus me-1"></i> Nueva Categoría
        </button>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card admin-card">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <span class="fw-semibold">Categorías registradas</span>
    </div>
    <div class="card-body table-responsive">
        <table id="tablaCategorias" class="table table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Total de Productos</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody id="tbodyCategorias"></tbody>
        </table>
    </div>
</div>

@if (User.HasPermission("categoria.crear") || User.HasPermission("categoria.actualizar"))
{
    <div class="modal fade" id="categoriaModal" tabindex="-1" aria-labelledby="categoriaModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form id="categoriaForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="Id" name="Id" />

                    <div class="modal-header">
                        <h2 class="modal-title h5" id="categoriaModalLabel">Registrar / Editar Categoría</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>

                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="Nombre" class="form-label">Nombre</label>
                            <input type="text" id="Nombre" name="Nombre" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label for="Descripcion" class="form-label">Descripción</label>
                            <textarea id="Descripcion" name="Descripcion" class="form-control" rows="2"></textarea>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" id="btnGuardarCategoria" class="btn btn-primary">Guardar Categoría</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/categoria.js" asp-append-version="true"></script>
}