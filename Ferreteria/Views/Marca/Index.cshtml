@using Ferreteria.Extensions
@{
    ViewData["Title"] = "Marcas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Marcas</h1>
        <p class="text-muted mb-0">Gestiona las marcas de productos de Fierro Nic.</p>
    </div>
    @if (User.HasPermission("marca.crear"))
    {
        <button type="button" id="btnNuevaMarca" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#marcaModal">
            <i class="fa-solid fa-plus me-1"></i> Nueva Marca
        </button>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card admin-card">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <span class="fw-semibold">Marcas registradas</span>
    </div>
    <div class="card-body table-responsive">
        <table id="tablaMarcas" class="table table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Total de Productos</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody id="tbodyMarcas"></tbody>
        </table>
    </div>
</div>

@if (User.HasPermission("marca.crear") || User.HasPermission("marca.actualizar"))
{
    <div class="modal fade" id="marcaModal" tabindex="-1" aria-labelledby="marcaModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form id="marcaForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="Id" name="Id" />

                    <div class="modal-header">
                        <h2 class="modal-title h5" id="marcaModalLabel">Registrar / Editar Marca</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>

                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="Name" class="form-label">Nombre</label>
                            <input type="text" id="Name" name="Name" class="form-control" maxlength="100" required />
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" id="btnGuardarMarca" class="btn btn-primary">Guardar Marca</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/marca.js" asp-append-version="true"></script>
}
