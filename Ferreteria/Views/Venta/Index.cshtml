@using Ferreteria.Extensions
@using System.Collections
@using System.Reflection
@{
    ViewData["Title"] = "Ventas";

    string GetPropValue(object? obj, params string[] names)
    {
        if (obj == null) return "";
        var type = obj.GetType();
        foreach (var name in names)
        {
            var prop = type.GetProperty(name, BindingFlags.Public | BindingFlags.Instance | BindingFlags.IgnoreCase);
            if (prop != null)
            {
                var val = prop.GetValue(obj);
                if (val != null) return val.ToString() ?? "";
            }
        }
        return "";
    }

    var clientes = ViewBag.Clientes as IEnumerable ?? Enumerable.Empty<object>();
    var empleados = ViewBag.Empleados as IEnumerable ?? Enumerable.Empty<object>();
    var almacenes = ViewBag.Almacenes as IEnumerable ?? Enumerable.Empty<object>();
    var productos = ViewBag.Productos as IEnumerable ?? Enumerable.Empty<object>();
    var metodosPago = ViewBag.MetodosPago as IEnumerable ?? Enumerable.Empty<object>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Ventas</h1>
        <p class="text-muted mb-0">Gestiona las ventas de Fierro Nic con DataTable</p>
    </div>
    @if (User.HasPermission("venta.crear"))
    {
        <button type="button" class="btn btn-primary btn-sm" id="btnNuevaVenta">
            <i class="fa-solid fa-plus me-1"></i> Nueva Venta
        </button>
    }
</div>

<div class="card admin-card">
    <div class="card-body">
        <table id="ventaTable" class="table table-striped table-hover w-100">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Fecha Venta</th>
                    <th>Cliente</th>
                    <th>Empleado</th>
                    <th>Almacén</th>
                    <th>Sucursal</th>
                    <th>Cant. Productos</th>
                    <th>Total</th>
                    <th>Acciones</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@if (User.HasPermission("venta.crear") || User.HasPermission("venta.actualizar"))
{
    <div class="modal fade" id="ventaModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="ventaModalTitle">Venta</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form id="ventaForm" novalidate>
                    @Html.AntiForgeryToken()
                    <div class="modal-body">
                        <input type="hidden" id="Id" name="Id" />
                        <input type="hidden" id="Total" name="Total" value="0" />

                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <label class="form-label" for="ClienteId">Cliente</label>
                                <select id="ClienteId" name="ClienteId" class="form-select">
                                    <option value="">-- Seleccione --</option>
                                    @foreach (var item in clientes)
                                    {
                                        var id = GetPropValue(item, "Id");
                                        var nombre = GetPropValue(item, "Name", "Nombre");
                                        var apellido = GetPropValue(item, "Apellido", "Apellidos");
                                        var texto = $"{nombre} {apellido}".Trim();
                                        if (!string.IsNullOrEmpty(id))
                                        {
                                            <option value="@id">@texto</option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label" for="EmpleadoId">Empleado</label>
                                <select id="EmpleadoId" name="EmpleadoId" class="form-select">
                                    <option value="">-- Seleccione --</option>
                                    @foreach (var item in empleados)
                                    {
                                        var id = GetPropValue(item, "Id");
                                        var nombres = GetPropValue(item, "Nombres", "Nombre", "Name");
                                        var apellidos = GetPropValue(item, "Apellidos", "Apellido");
                                        var texto = $"{nombres} {apellidos}".Trim();
                                        if (!string.IsNullOrEmpty(id))
                                        {
                                            <option value="@id">@texto</option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label" for="AlmacenId">Almacén</label>
                                <select id="AlmacenId" name="AlmacenId" class="form-select">
                                    <option value="">-- Seleccione --</option>
                                    @foreach (var item in almacenes)
                                    {
                                        var id = GetPropValue(item, "Id");
                                        var texto = GetPropValue(item, "Name", "Nombre");
                                        if (!string.IsNullOrEmpty(id))
                                        {
                                            <option value="@id">@texto</option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label" for="MetodoPagoId">Método de Pago</label>
                                <select id="MetodoPagoId" name="MetodoPagoId" class="form-select">
                                    <option value="">-- Seleccione --</option>
                                    @foreach (var item in metodosPago)
                                    {
                                        var id = GetPropValue(item, "Id");
                                        var texto = GetPropValue(item, "Name", "Nombre");
                                        if (!string.IsNullOrEmpty(id))
                                        {
                                            <option value="@id">@texto</option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="col-md-6" id="grupoFechaVenta">
                                <label class="form-label" for="FechaVenta">Fecha de Venta</label>
                                <input type="datetime-local" id="FechaVenta" name="FechaVenta" class="form-control" />
                            </div>

                            <div class="col-md-12" id="grupoComprobante" style="display: none;">
                                <label class="form-label" for="NumeroComprobante">N° Voucher / Referencia (Tarjeta o Transferencia)</label>
                                <input type="text" id="NumeroComprobante" name="NumeroComprobante" class="form-control" maxlength="100" placeholder="Ej. Voucher 004582 o Ref. bancaria" />
                            </div>
                        </div>

                        <div id="seccionDetalleVenta" class="row g-3 align-items-end border-top pt-3 mb-3">
                            <div class="col-md-5">
                                <label class="form-label" for="ProductoId">Producto</label>
                                <select id="ProductoId" name="ProductoId" class="form-select">
                                    <option value="">-- Seleccione --</option>
                                    @foreach (var item in productos)
                                    {
                                        var id = GetPropValue(item, "Id");
                                        var texto = GetPropValue(item, "Nombre", "Name");
                                        var precio = GetPropValue(item, "PrecioVenta", "PrecioCompra", "Precio");
                                        if (!string.IsNullOrEmpty(id))
                                        {
                                            <option value="@id" data-precio="@precio">@texto</option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label" for="Cantidad">Cantidad</label>
                                <input type="number" min="1" id="Cantidad" name="Cantidad" class="form-control" inputmode="numeric" />
                            </div>

                            <div class="col-md-2">
                                <label class="form-label" for="PrecioUnitario">Precio</label>
                                <input type="number" step="0.01" min="0.01" id="PrecioUnitario" name="PrecioUnitario" class="form-control" inputmode="decimal" />
                            </div>

                            <div class="col-md-2 d-grid">
                                <button type="button" class="btn btn-outline-primary" id="btnAgregarDetalle">
                                    Agregar
                                </button>
                            </div>
                        </div>

                        <div class="table-responsive" id="contenedorTablaDetalleVenta">
                            <table id="detalleVentaTable" class="table table-bordered table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Producto</th>
                                        <th>Cantidad</th>
                                        <th>Precio Unit.</th>
                                        <th>Subtotal</th>
                                        <th>Quitar</th>
                                    </tr>
                                </thead>
                                <tbody id="tbodyDetalleVenta"></tbody>
                            </table>
                        </div>

                        <div class="mt-3 text-end fw-semibold" id="contenedorTotalVenta">
                            Total: <span id="lblTotalVenta">0.00</span>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary" id="btnGuardarVenta">Guardar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
}

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://unpkg.com/just-validate@4.3.0/dist/just-validate.production.min.js"></script>
    <script>
        window.ventasConfig = {
            canUpdate: @User.HasPermission("venta.actualizar").ToString().ToLower(),
            canDelete: @User.HasPermission("venta.borrar").ToString().ToLower()
        };
    </script>
    <script src="~/js/venta.js" asp-append-version="true"></script>
}