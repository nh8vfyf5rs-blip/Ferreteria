@using Ferreteria.Extensions
@{
    ViewData["Title"] = "Compras";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Compras</h1>
        <p class="text-muted mb-0">Gestiona las compras con DataTable</p>
    </div>
    @if (User.HasPermission("compra.crear"))
    {
        <button type="button" class="btn btn-primary btn-sm" id="btnNuevaCompra">
            <i class="fa-solid fa-plus me-1"></i> Nueva Compra
        </button>
    }
</div>

<div class="card admin-card">
    <div class="card-body">
        <table id="compraTable" class="table table-striped table-hover w-100">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Fecha Compra</th>
                    <th>Proveedor</th>
                    <th>Empleado</th>
                    <th>Almacén</th>
                    <th>Sucursal</th>
                    <th>Total</th>
                    <th>Acciones</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@if (User.HasPermission("compra.crear") || User.HasPermission("compra.actualizar"))
{
    <div class="modal fade" id="compraModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="compraModalTitle">Compra</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form id="compraForm" novalidate>
                    @Html.AntiForgeryToken()
                    <div class="modal-body">
                        <input type="hidden" id="Id" name="Id" />

                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <label class="form-label" for="ProveedorId">Proveedor</label>
                                <select id="ProveedorId" name="ProveedorId" asp-items="ViewBag.Proveedores" class="form-select">
                                    <option value="">-- Seleccione --</option>
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label" for="EmpleadoId">Empleado</label>
                                <select id="EmpleadoId" name="EmpleadoId" asp-items="ViewBag.Empleados" class="form-select">
                                    <option value="">-- Seleccione --</option>
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label" for="AlmacenId">Almacén</label>
                                <select id="AlmacenId" name="AlmacenId" asp-items="ViewBag.Almacenes" class="form-select">
                                    <option value="">-- Seleccione --</option>
                                </select>
                            </div>
                        </div>

                        <div class="row g-3 align-items-end border-top pt-3 mb-3">
                            <div class="col-md-5">
                                <label class="form-label" for="ProductoId">Producto</label>
                                <select id="ProductoId" name="ProductoId" asp-items="ViewBag.Productos" class="form-select">
                                    <option value="">-- Seleccione --</option>
                                </select>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label" for="Cantidad">Cantidad</label>
                                <input type="number" min="1" id="Cantidad" name="Cantidad" class="form-control" />
                            </div>

                            <div class="col-md-2">
                                <label class="form-label" for="PrecioUnitario">Precio</label>
                                <input type="number" step="0.01" min="0.01" id="PrecioUnitario" name="PrecioUnitario" class="form-control" />
                            </div>

                            <div class="col-md-2 d-grid">
                                <button type="button" class="btn btn-outline-primary" id="btnAgregarDetalle">
                                    Agregar
                                </button>
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table id="detalleCompraTable" class="table table-bordered table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Producto</th>
                                        <th>Cantidad</th>
                                        <th>Precio Unit.</th>
                                        <th>Subtotal</th>
                                        <th>Quitar</th>
                                    </tr>
                                </thead>
                                <tbody id="tbodyDetalleCompra"></tbody>
                            </table>
                        </div>

                        <div class="mt-3 text-end fw-semibold">
                            Total: <span id="lblTotalCompra">0.00</span>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary" id="btnGuardarCompra">Guardar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
}

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://unpkg.com/just-validate@4.3.0/dist/just-validate.production.min.js"></script>
    <script>
        window.comprasConfig = {
            canUpdate: @User.HasPermission("compra.actualizar").ToString().ToLower(),
            canDelete: @User.HasPermission("compra.borrar").ToString().ToLower()
        };
    </script>
    <script src="~/js/compra.js" asp-append-version="true"></script>
}
