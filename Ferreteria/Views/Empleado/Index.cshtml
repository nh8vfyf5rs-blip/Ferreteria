@using Ferreteria.Extensions
@using System.Collections
@using System.Reflection
@{
    ViewData["Title"] = "Empleados";

    string GetPropValue(object? obj, params string[] names)
    {
        if (obj == null) return "";
        var type = obj.GetType();
        foreach (var name in names)
        {
            var prop = type.GetProperty(name, BindingFlags.Public | BindingFlags.Instance | BindingFlags.IgnoreCase);
            if (prop != null)
            {
                var val = prop.GetValue(obj);
                if (val != null) return val.ToString() ?? "";
            }
        }
        return "";
    }

    IEnumerable ExtractEnumerable(object? source)
    {
        if (source == null) return Enumerable.Empty<object>();
        if (source is IEnumerable enumerable and not string)
            return enumerable;

        var type = source.GetType();
        foreach (var propName in new[] { "Data", "Items", "Results", "List" })
        {
            var prop = type.GetProperty(propName, BindingFlags.Public | BindingFlags.Instance | BindingFlags.IgnoreCase);
            if (prop?.GetValue(source) is IEnumerable inner and not string)
                return inner;
        }
        return Enumerable.Empty<object>();
    }

    var cargos = ExtractEnumerable(ViewBag.Cargos);
    var sucursales = ExtractEnumerable(ViewBag.Sucursales);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Empleados</h1>
        <p class="text-muted mb-0">Gestiona los empleados de Fierro Nic con DataTable</p>
    </div>
    @if (User.HasPermission("empleado.crear"))
    {
        <button type="button" class="btn btn-primary btn-sm" id="btnNuevoEmpleado">
            <i class="fa-solid fa-plus me-1"></i> Nuevo Empleado
        </button>
    }
</div>

<div class="card admin-card">
    <div class="card-body">
        <table id="empleadoTable" class="table table-striped table-hover w-100">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombres</th>
                    <th>Apellidos</th>
                    <th>Cédula</th>
                    <th>Teléfono</th>
                    <th>Correo</th>
                    <th>Dirección</th>
                    <th>Fecha Contratación</th>
                    <th>Salario</th>
                    <th>Cargo</th>
                    <th>Sucursal</th>
                    <th>Acciones</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@if (User.HasPermission("empleado.crear") || User.HasPermission("empleado.actualizar"))
{
    <div class="modal fade" id="empleadoModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="empleadoModalTitle">Empleado</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form id="empleadoForm" novalidate>
                    @Html.AntiForgeryToken()
                    <div class="modal-body">
                        <input type="hidden" id="Id" name="Id" />

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label" for="Nombres">Nombres</label>
                                <input type="text" id="Nombres" name="Nombres" class="form-control solo-letras" maxlength="100" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label" for="Apellidos">Apellidos</label>
                                <input type="text" id="Apellidos" name="Apellidos" class="form-control solo-letras" maxlength="100" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label" for="Cedula">Cédula</label>
                                <input type="text" id="Cedula" name="Cedula" class="form-control" maxlength="30" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label" for="Telefono">Teléfono</label>
                                <input type="text" id="Telefono" name="Telefono" class="form-control solo-telefono" maxlength="8" inputmode="numeric" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label" for="Correo">Correo</label>
                                <input type="email" id="Correo" name="Correo" class="form-control" maxlength="120" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label" for="CargoId">Cargo</label>
                                <select id="CargoId" name="CargoId" class="form-select">
                                    <option value="">-- Seleccione --</option>
                                    @foreach (var cargo in cargos)
                                    {
                                        var id = GetPropValue(cargo, "Id", "id");
                                        var nombre = GetPropValue(cargo, "Nombre", "nombre", "Name", "name", "Descripcion", "descripcion");
                                        if (!string.IsNullOrWhiteSpace(id))
                                        {
                                            <option value="@id">@nombre</option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label" for="SucursalId">Sucursal</label>
                                <select id="SucursalId" name="SucursalId" class="form-select">
                                    <option value="">-- Seleccione --</option>
                                    @foreach (var sucursal in sucursales)
                                    {
                                        var id = GetPropValue(sucursal, "Id", "id");
                                        var nombre = GetPropValue(sucursal, "Nombre", "nombre", "Name", "name");
                                        if (!string.IsNullOrWhiteSpace(id))
                                        {
                                            <option value="@id">@nombre</option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label" for="FechaContratacion">Fecha de Contratación</label>
                                <input type="date" id="FechaContratacion" name="FechaContratacion" class="form-control" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label" for="Salario">Salario</label>
                                <input type="number" step="0.01" min="0" id="Salario" name="Salario" class="form-control" inputmode="decimal" maxlength="12" />
                            </div>

                            <div class="col-12">
                                <label class="form-label" for="Direccion">Dirección</label>
                                <input type="text" id="Direccion" name="Direccion" class="form-control" maxlength="200" />
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary" id="btnGuardarEmpleado">Guardar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
}

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://unpkg.com/just-validate@4.3.0/dist/just-validate.production.min.js"></script>
    <script>
        window.empleadosConfig = {
            canUpdate: @User.HasPermission("empleado.actualizar").ToString().ToLower(),
            canDelete: @User.HasPermission("empleado.borrar").ToString().ToLower()
        };
    </script>
    <script src="~/js/empleado.js" asp-append-version="true"></script>
}