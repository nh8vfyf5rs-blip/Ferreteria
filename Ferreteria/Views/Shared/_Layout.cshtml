<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Ferretería</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Ferreteria.styles.css" asp-append-version="true" />
</head>

<body>
    <div class="app-container">
        <div class="app-container"> 
  <!-- Menú lateral -->
        <aside class="sidebar">
            <div class="sidebar-brand">
                <div class="brand-icon">🔨</div>
                <div>
                    <h4>Ferretería</h4>
                    <small>Sistema de gestión</small>
                </div>
            </div>

            <div class="sidebar-menu">
                <p class="menu-title">MENÚ PRINCIPAL</p>

                <a class="menu-link active"
                   asp-controller="Home" asp-action="Index">
                    <span>▦</span> Dashboard
                </a>

                <a class="menu-link" href="#">
                    <span>📦</span> Productos
                </a>

                <a class="menu-link" href="#">
                    <span>👥</span> Clientes
                </a>

                <a class="menu-link" href="#">
                    <span>🛒</span> Ventas
                </a>

                <a class="menu-link" href="#">
                    <span>🧾</span> Compras
                </a>

                <a class="menu-link" href="#">
                    <span>🏬</span> Inventario
                </a>

                <a class="menu-link" href="#">
                    <span>📊</span> Reportes
                </a>

                <p class="menu-title menu-separator">CONFIGURACIÓN</p>

                <a class="menu-link" href="#">
                    <span>⚙</span> Configuración
                </a>
            </div>

            <div class="sidebar-footer">
                <span>●</span> Sistema Ferretería
            </div>
        </aside>

        <!-- Contenido principal -->
        <div class="main-container">

            <header class="topbar">
                <div>
                    <h5>@ViewData["Title"]</h5>
                    <small>Panel de administración</small>
                </div>

                <div class="topbar-user">
                    <span class="notification-icon">🔔</span>
                    <div class="user-avatar">A</div>
                    <div>
                        <strong>Administrador</strong>
                        <small>Usuario del sistema</small>
                    </div>
                </div>
            </header>

            <main class="main-content">
                @RenderBody()
            </main>

            <footer class="app-footer">
                Ferretería - Tu aliado en cada proyecto.
                <span>© 2026</span>
            </footer>

        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

