@{
    Layout = null;
    ViewData["Title"] = "Dashboard";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - fierro Nic</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>
<body>
    <div class="app-layout">
        <aside class="app-sidebar">
            <div>
                <div class="sidebar-brand">
                    <div class="kpi-icon-box">
                        <i class="fa-solid fa-hammer"></i>
                    </div>
                    <div>
                        <div class="sidebar-brand-title">fierro Nic</div>
                        <div class="sidebar-brand-sub">Ferretería</div>
                    </div>
                </div>

                <div class="sidebar-section-label">Principal</div>
                <ul class="sidebar-nav">
                    <li><a asp-controller="Auth" asp-action="Login" class="sidebar-link"><i class="fa-solid fa-right-to-bracket"></i> Inicio de sesión</a></li>
                    <li><a asp-controller="Home" asp-action="Index" class="sidebar-link active"><i class="fa-solid fa-table-cells-large"></i> Dashboard</a></li>
                    <li><a asp-controller="Producto" asp-action="Index" class="sidebar-link"><i class="fa-solid fa-box"></i> Productos</a></li>
                    <li><a asp-controller="Producto" asp-action="Index" asp-fragment="nuevo" class="sidebar-link"><i class="fa-solid fa-pen-to-square"></i> Registrar / editar producto</a></li>
                    <li><a asp-controller="Categoria" asp-action="Index" class="sidebar-link"><i class="fa-solid fa-tag"></i> Categorías</a></li>
                    <li><a asp-controller="Proveedor" asp-action="Index" class="sidebar-link"><i class="fa-solid fa-truck"></i> Proveedores</a></li>
                    <li><a asp-controller="Cliente" asp-action="Index" class="sidebar-link"><i class="fa-solid fa-users"></i> Clientes</a></li>
                    <li><a asp-controller="Venta" asp-action="Index" class="sidebar-link"><i class="fa-solid fa-cart-shopping"></i> Ventas</a></li>
                    <li><a asp-controller="Compra" asp-action="Index" class="sidebar-link"><i class="fa-solid fa-bag-shopping"></i> Compras</a></li>
                    <li><a asp-controller="Inventario" asp-action="Index" class="sidebar-link"><i class="fa-solid fa-chart-column"></i> Inventario</a></li>
                    <li><a asp-controller="Admin" asp-action="Users" class="sidebar-link"><i class="fa-solid fa-user"></i> Usuarios</a></li>
                    <li><a asp-controller="Admin" asp-action="Roles" class="sidebar-link"><i class="fa-solid fa-shield-halved"></i> Roles y permisos</a></li>
                    <li><a asp-controller="Sucursal" asp-action="Index" class="sidebar-link"><i class="fa-solid fa-store"></i> Sucursales</a></li>
                    <li><a asp-controller="Venta" asp-action="Index" class="sidebar-link"><i class="fa-solid fa-file-lines"></i> Reportes</a></li>
                </ul>
            </div>

            <div>
                <div class="sidebar-footer-card">
                    <div class="fw-semibold mb-1"><i class="fa-regular fa-circle-question me-1"></i> ¿Necesitas ayuda?</div>
                    <div class="text-white-50">Visita el centro de ayuda</div>
                </div>

                <div class="sidebar-footer-card">
                    <div class="fw-semibold">Sucursal Centro</div>
                    <div class="text-white-50">Caja 01 · Sistema conectado</div>
                </div>
            </div>
        </aside>

        <div class="app-main-wrapper">
            <header class="app-topbar">
                <div>
                    <div class="fw-semibold small">Sucursal Centro</div>
                    <div class="text-muted" style="font-size: 0.72rem;">Panel de administración</div>
                </div>

                <div class="topbar-search">
                    <i class="fa-solid fa-magnifying-glass" style="position: absolute; left: 0.75rem; top: 50%; transform: translateY(-50%); font-size: 0.85rem; color: #6B6878; pointer-events: none;"></i>
                    <input type="text" id="dashboardSearchInput" placeholder="Buscar productos, clientes, ventas..." />
                </div>

                <div class="topbar-user">
                    <button type="button" class="btn btn-sm btn-light border-0" title="Notificaciones">
                        <i class="fa-regular fa-bell"></i>
                    </button>
                    <div class="topbar-avatar">MG</div>
                    <div class="d-none d-sm-block lh-1">
                        <div class="fw-semibold small">María González</div>
                        <div class="text-muted" style="font-size: 0.7rem;">Cajera · Turno de mañana</div>
                    </div>
                </div>
            </header>

            <main class="dashboard-content">
                <div class="dashboard-header">
                    <div>
                        <div class="text-uppercase fw-semibold text-muted" style="font-size: 0.68rem; letter-spacing: 0.05em;">Resumen general</div>
                        <h1 class="dashboard-title">Dashboard</h1>
                        <p class="dashboard-subtitle">Todo lo que necesitas para comenzar tu día.</p>
                    </div>

                    <a asp-controller="Venta" asp-action="Index" class="btn-registrar-venta">
                        <i class="fa-solid fa-plus"></i> Registrar venta
                    </a>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="kpi-card">
                            <div class="kpi-top">
                                <span class="kpi-label">Total de productos</span>
                                <span class="kpi-icon-box"><i class="fa-solid fa-cube"></i></span>
                            </div>
                            <div class="kpi-value" id="kpiTotalProductos">128</div>
                            <div class="kpi-meta">productos en catálogo</div>
                        </div>
                    </div>

                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="kpi-card">
                            <div class="kpi-top">
                                <span class="kpi-label">Ventas del mes</span>
                                <span class="kpi-icon-box"><i class="fa-solid fa-cart-shopping"></i></span>
                            </div>
                            <div class="kpi-value" id="kpiVentasMes">348</div>
                            <div class="kpi-meta">operaciones registradas</div>
                        </div>
                    </div>

                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="kpi-card">
                            <div class="kpi-top">
                                <span class="kpi-label">Clientes</span>
                                <span class="kpi-icon-box"><i class="fa-solid fa-user-group"></i></span>
                            </div>
                            <div class="kpi-value" id="kpiTotalClientes">256</div>
                            <div class="kpi-meta">clientes registrados</div>
                        </div>
                    </div>

                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="kpi-card">
                            <div class="kpi-top">
                                <span class="kpi-label">Ingresos del mes</span>
                                <span class="kpi-icon-box"><i class="fa-solid fa-wallet"></i></span>
                            </div>
                            <div class="kpi-value" id="kpiIngresosMes">$148,520</div>
                            <div class="kpi-meta">IVA incluido</div>
                        </div>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-12 col-lg-8">
                        <div class="dash-panel">
                            <div class="dash-panel-header">
                                <div>
                                    <h2 class="dash-panel-title">Ventas recientes</h2>
                                    <p class="dash-panel-sub">Últimos movimientos de tu sucursal</p>
                                </div>
                                <a asp-controller="Venta" asp-action="Index" class="text-decoration-none small fw-semibold" style="color: var(--dash-lila-icon);">
                                    Ver todas <i class="fa-solid fa-chevron-right ms-1" style="font-size: 0.7rem;"></i>
                                </a>
                            </div>

                            <div class="table-responsive">
                                <table class="recent-sales-table" id="recentSalesTable">
                                    <thead>
                                        <tr>
                                            <th>Venta</th>
                                            <th>Cliente</th>
                                            <th>Fecha</th>
                                            <th>Estado</th>
                                            <th class="text-end">Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td class="fw-semibold">#V-00128</td>
                                            <td>Público en general</td>
                                            <td class="text-muted">18 nov · 10:42</td>
                                            <td><span class="badge-estado-pendiente">En curso</span></td>
                                            <td class="text-end fw-semibold">$1,582.00</td>
                                        </tr>
                                        <tr>
                                            <td class="fw-semibold">#V-00127</td>
                                            <td>Carlos Ramírez</td>
                                            <td class="text-muted">18 nov · 10:28</td>
                                            <td><span class="badge-estado-completada">Completada</span></td>
                                            <td class="text-end fw-semibold">$845.00</td>
                                        </tr>
                                        <tr>
                                            <td class="fw-semibold">#V-00126</td>
                                            <td>Ana Martínez</td>
                                            <td class="text-muted">18 nov · 10:15</td>
                                            <td><span class="badge-estado-completada">Completada</span></td>
                                            <td class="text-end fw-semibold">$2,340.00</td>
                                        </tr>
                                        <tr>
                                            <td class="fw-semibold">#V-00125</td>
                                            <td>Luis Hernández</td>
                                            <td class="text-muted">18 nov · 09:56</td>
                                            <td><span class="badge-estado-completada">Completada</span></td>
                                            <td class="text-end fw-semibold">$459.00</td>
                                        </tr>
                                        <tr>
                                            <td class="fw-semibold">#V-00124</td>
                                            <td>Sofía López</td>
                                            <td class="text-muted">18 nov · 09:32</td>
                                            <td><span class="badge-estado-completada">Completada</span></td>
                                            <td class="text-end fw-semibold">$1,125.50</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mt-3 text-muted" style="font-size: 0.72rem;">
                                <span>Mostrando las últimas 5 ventas</span>
                                <span><i class="fa-regular fa-clock me-1"></i> Actualizado ahora</span>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-lg-4">
                        <div class="dash-panel">
                            <div class="dash-panel-header">
                                <div>
                                    <h2 class="dash-panel-title">Actividad reciente</h2>
                                    <p class="dash-panel-sub">Lo que está pasando en tu negocio</p>
                                </div>
                            </div>

                            <ul class="activity-list">
                                <li class="activity-item">
                                    <span class="activity-icon"><i class="fa-solid fa-cart-shopping"></i></span>
                                    <div>
                                        <p class="activity-title">Venta completada</p>
                                        <p class="activity-detail">Carlos Ramírez · $845.00 · Hace 14 minutos</p>
                                    </div>
                                </li>
                                <li class="activity-item">
                                    <span class="activity-icon"><i class="fa-solid fa-box"></i></span>
                                    <div>
                                        <p class="activity-title">Inventario actualizado</p>
                                        <p class="activity-detail">24 piezas · Taladro percutor 1/2" · Hace 25 minutos</p>
                                    </div>
                                </li>
                                <li class="activity-item">
                                    <span class="activity-icon"><i class="fa-solid fa-user-plus"></i></span>
                                    <div>
                                        <p class="activity-title">Nuevo cliente registrado</p>
                                        <p class="activity-detail">Sofía López · Hace 38 minutos</p>
                                    </div>
                                </li>
                                <li class="activity-item">
                                    <span class="activity-icon"><i class="fa-solid fa-check"></i></span>
                                    <div>
                                        <p class="activity-title">Caja abierta</p>
                                        <p class="activity-detail">María González · Caja 01 · Hoy, 09:00</p>
                                    </div>
                                </li>
                            </ul>

                            <div class="border-top mt-3 pt-2 d-flex justify-content-between align-items-center">
                                <a asp-controller="Venta" asp-action="Index" class="text-decoration-none small fw-semibold" style="color: var(--dash-text);">
                                    Toda la actividad
                                </a>
                                <i class="fa-solid fa-arrow-right small"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex flex-wrap justify-content-between align-items-center mt-4 pt-2 border-top text-muted" style="font-size: 0.74rem;">
                    <div><i class="fa-regular fa-calendar me-1"></i> Resumen de noviembre de 2026</div>
                    <div>Sucursal Centro · Importes en C$ / $</div>
                </div>
            </main>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
</body>
</html>
